.venv/
__pycache__/
.pytest_cache/
*.pyc
.DS_Store

# Generated outputs
output/*
!output/.gitkeep

# Manual-chat and production records stay local.
workspace/requests/*
!workspace/requests/.gitkeep
workspace/responses/*
!workspace/responses/.gitkeep
workspace/reviews/*
!workspace/reviews/.gitkeep
workspace/human_qa/*
!workspace/human_qa/.gitkeep
workspace/releases/*
!workspace/releases/.gitkeep
workspace/ui_temp/*
!workspace/ui_temp/.gitkeep
workspace/exams/*
!workspace/exams/.gitkeep

# Full exam projects contain unpublished production content. Keep the live bank local;
# commit curated pilots/fixtures explicitly instead.
exam_bank/draft/*
!exam_bank/draft/.gitkeep
exam_bank/approved/*
!exam_bank/approved/.gitkeep
